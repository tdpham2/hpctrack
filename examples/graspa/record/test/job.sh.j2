# Resource directives are generated by hpctrack from record.yaml.
bash -lc '
set -e
cd "$1"
module load PrgEnv-nvidia
export OMP_NUM_THREADS=1
export CUDA_VISIBLE_DEVICES=0
cp -R "$2"/. .
mpiexec -n 1 -ppn 1 --depth=1 --cpu-bind depth "$3/bin/nvc_main.x" \
    > graspa.stdout.log 2> graspa.stderr.log
' hpctrack {{ workdir | quote }} {{ input_dir | quote }} {{ prefix | quote }}
